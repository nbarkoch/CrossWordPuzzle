{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react",
    "skipLibCheck": true,
    "types": ["jest"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
